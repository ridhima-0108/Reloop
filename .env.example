# RELOOP Circular Economy Platform Environment Configuration

# Gemini API Key (Optional for demo! If omitted, RELOOP automatically uses Demo Mode with 100% realistic responses)
GEMINI_API_KEY=

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Server Port
PORT=8000

# Optional Database (Falls back automatically to local SQLite reloop.db)
# SUPABASE_URL=
# SUPABASE_KEY=

# Google Maps API Key (Optional! Falls back to Leaflet + OpenStreetMap with zero setup)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=
